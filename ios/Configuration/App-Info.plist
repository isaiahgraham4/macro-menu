        <dict>
            <key>INAlternativeAppName</key><string>Leaner</string>
            <key>INAlternativeAppNamePronunciationHint</key><string>lee ner</string>
        </dict>
        <dict>
            <key>INAlternativeAppName</key><string>Lean R</string>
            <key>INAlternativeAppNamePronunciationHint</key><string>lean are</string>
        </dict>
    </array>
</dict></plist>
